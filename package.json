{
  "name": "forkiva",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "run-p --race --print-label dev:server dev:assets dev:queue dev:schedule",
    "dev:server": "php artisan serve",
    "dev:assets": "vite",
    "dev:queue": "php artisan queue:listen --tries=1",
    "dev:schedule": "php artisan schedule:work",
    "build": "yarn build-only && yarn type-check",
    "build-only": "vite build",
    "icons:build": "jiti ./resources/js/app/plugins/iconify/build-icons.ts",
    "browser:install": "puppeteer browsers install chrome",
    "test": "vitest run",
    "type-check": "vue-tsc --build",
    "lint": "eslint 'resources/js/**/*.{ts,vue}' 'Modules/*/resources/assets/js/**/*.{ts,vue}' '*.ts' scripts",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --ignore-path .prettierignore resources/js 'Modules/*/resources/assets/js/**/*.{ts,vue,json,scss,css}' '*.ts' 'tsconfig*.json' package.json scripts --write",
    "format:check": "prettier --ignore-path .prettierignore resources/js 'Modules/*/resources/assets/js/**/*.{ts,vue,json,scss,css}' '*.ts' 'tsconfig*.json' package.json scripts --check",
    "check:modules": "jiti scripts/check-modules.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/cairo": "^5.2.7",
    "@iconify-json/bx": "^1.2.2",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.25",
    "@iconify/tools": "^5.0.1",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.0",
    "@iconify/vue": "^5.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/node24": "^24.0.3",
    "@types/dropzone": "^5.7.9",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.29",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.1.0",
    "@vueuse/math": "^14.1.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "dropzone": "6.0.0-beta.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.3.4",
    "eslint-plugin-oxlint": "~1.29.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "gridstack": "^13.2.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.29.0",
    "pinia": "^3.0.4",
    "prettier": "^3.9.6",
    "qrcode-vue3": "^1.7.1",
    "sass-embedded": "^1.97.1",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-router": "^0.19.1",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vue-layouts-next": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vite-svg-loader": "^5.1.0",
    "vitest": "3.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.2.7",
    "vue-router": "4",
    "vue-toastification": "2.0.0-rc.5",
    "vue-tree-dnd": "^0.2.4",
    "vue-tsc": "^3.3.9",
    "vue3-perfect-scrollbar": "^2.0.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.11.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.0",
    "laravel-vite-plugin": "^2.1.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "puppeteer": "^25.9.0"
  },
  "resolutions": {
    "eslint-config-vuetify/**/brace-expansion": "1.1.18",
    "@vue/test-utils/**/brace-expansion": "2.1.4",
    "vite-plugin-pwa/**/brace-expansion": "2.1.4",
    "@vue/eslint-config-typescript/**/brace-expansion": "5.0.9",
    "**/fast-uri": "3.1.5",
    "**/immutable": "5.1.8",
    "**/js-yaml": "4.3.2",
    "**/nanoid": "3.3.18",
    "**/postcss": "8.5.28",
    "**/shell-quote": "1.9.0",
    "vite-svg-loader/**/svgo": "3.3.5",
    "@iconify/tools/**/svgo": "4.1.0"
  }
}
