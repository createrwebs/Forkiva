APP_NAME=Forkiva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://forkiva.test
SANCTUM_EXPIRATION=10080

PASSKEYS_RELYING_PARTY_ID=
PASSKEYS_ALLOWED_ORIGINS=
PASSKEYS_ENABLED=false
PASSKEYS_USER_HANDLE_SECRET=
PASSKEYS_CACHE_STORE=database
PASSKEYS_TIMEOUT=60000
TWO_FACTOR_CACHE_STORE=database
GRATUITY_WRITES_ENABLED=false
PAYROLL_PAYMENT_WRITES_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forkiva
DB_USERNAME=root
DB_PASSWORD=
DB_ENABLE_LOG=false
# Optional absolute client paths when database tools are not available in PATH.
DB_DUMP_BINARY=
DB_RESTORE_BINARY=
# Optional directory searched before relying on the web process PATH.
DB_TOOL_BINARY_DIRECTORY=
# Multiple directories use the operating system PATH separator (`:` on Unix, `;` on Windows).
DB_TOOL_BINARY_DIRECTORIES=
DB_TOOL_PROCESS_TIMEOUT=1800
DB_TOOL_LOCK_SECONDS=3600
DB_TOOL_MAX_UPLOAD_KB=512000
DB_TOOL_MAINTENANCE_DURING_RESTORE=true
DB_TOOL_PAUSE_QUEUE_DURING_RESTORE=true
DB_TOOL_QUEUE=default
DB_TOOL_RETENTION_COUNT=20
# Enable for multi-server deployments; use Redis, Memcached, or DynamoDB cache.
DB_TOOL_REQUIRE_DISTRIBUTED_LOCK=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DOWNLOAD_URL_TTL_MINUTES=10
QUEUE_CONNECTION=sync

# PDF defaults. Saved values in System Settings > PDF take precedence.
LARAVEL_PDF_DRIVER=dompdf
LARAVEL_PDF_DOMPDF_REMOTE_ENABLED=false
LARAVEL_PDF_DOMPDF_CHROOT=
LARAVEL_PDF_NODE_BINARY=
LARAVEL_PDF_NPM_BINARY=
LARAVEL_PDF_CHROME_PATH=
LARAVEL_PDF_NODE_MODULES_PATH=
LARAVEL_PDF_NO_SANDBOX=false
LARAVEL_PDF_CHROME_BINARY=
LARAVEL_PDF_CHROME_NO_SANDBOX=false
LARAVEL_PDF_CHROME_STARTUP_TIMEOUT=30
LARAVEL_PDF_CHROME_TIMEOUT=30000
LARAVEL_PDF_CHROME_OPERATION_TIMEOUT=5000
LARAVEL_PDF_CHROME_USER_DATA_DIR=
LARAVEL_PDF_WEASYPRINT_BINARY=weasyprint
LARAVEL_PDF_WEASYPRINT_TIMEOUT=10
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GOTENBERG_URL=http://localhost:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

CACHE_STORE=file
CACHE_ENABLED=false
CART_MUTATION_LOCK_STORE=file
# All application servers must use the same lock store. Use database for multiple servers.
CART_MUTATION_LOCK_RETRY_MILLISECONDS=25
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FIREBASE_PROJECT=app
FIREBASE_CREDENTIALS=/absolute/path/to/backend/storage/app/firebase/service-account.json
FIREBASE_HTTP_CLIENT_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_SEED_DEMO_DATA=false

VITE_STORAGE_ENCRYPT_ALL=false
VITE_STORAGE_ENCRYPTION_KEY=Fu70sxNnJwoTzCdsr7AmB/8OFHyVhGPfCXWo3MLWi7s=
