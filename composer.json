{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-zip": "*",
        "jackiedo/dotenv-editor": "^1.1",
        "jenssegers/agent": "^2.6",
        "laravel-notification-channels/fcm": "^5.0",
        "laravel/framework": "^12.0",
        "laravel/passkeys": "^0.2.1",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^12.0",
        "php-http/guzzle7-adapter": "^1.1",
        "predis/predis": "^3.6",
        "propaganistas/laravel-phone": "^6.0",
        "staudenmeir/belongs-to-through": "^2.17",
        "swayok/alternative-laravel-cache": "^6.3",
        "symfony/html-sanitizer": "^7.4.12",
        "symfony/psr-http-message-bridge": "^7.2",
        "wikimedia/composer-merge-plugin": "^2.1",
        "ext-pdo": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.92",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "yarn dev"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:accounting:mysql": [
            "@test:accounting:mysql:management",
            "@test:accounting:mysql:tax-compliance",
            "@test:accounting:mysql:reliability",
            "@test:accounting:mysql:operational-concurrency",
            "@test:accounting:mysql:procurement-concurrency"
        ],
        "test:accounting:mysql:management": "@php vendor/bin/phpunit --configuration phpunit.mysql.xml Modules/Accounting/tests/Feature/ManagementAccounting/ManagementAccountingSchemaMySqlTest.php Modules/Accounting/tests/Feature/ManagementAccounting/ManagementAccountingConcurrencyMySqlTest.php",
        "test:accounting:mysql:tax-compliance": "@php vendor/bin/phpunit --configuration phpunit.mysql.xml Modules/Accounting/tests/Feature/Compliance/TaxComplianceMySqlMigrationTest.php Modules/Accounting/tests/Feature/Compliance/TaxComplianceMySqlConcurrencyTest.php",
        "test:accounting:mysql:reliability": "@php vendor/bin/phpunit --configuration phpunit.mysql.xml Modules/Accounting/tests/Feature/Reliability/AccountingReliabilityTest.php",
        "test:accounting:mysql:operational-concurrency": "@php vendor/bin/phpunit --configuration phpunit.mysql.xml Modules/Accounting/tests/Feature/Posting/OperationalFinanceMySqlConcurrencyTest.php",
        "test:accounting:mysql:procurement-concurrency": "@php vendor/bin/phpunit --configuration phpunit.mysql.xml Modules/Accounting/tests/Feature/Posting/ProcurementInventoryMySqlConcurrencyTest.php",
        "ide-helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models --nowrite"
        ],
        "build": "yarn build"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "swayok/alternative-laravel-cache"
            ]
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
