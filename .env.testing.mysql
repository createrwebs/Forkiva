APP_ENV=testing
APP_KEY=
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# The concurrency suite refuses to run unless this name ends in `_test`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forkiva_test
DB_USERNAME=root
DB_PASSWORD=

# Use phpunit.mysql.xml for Accounting reliability and concurrency verification.
# Override these values in CI when needed. The MySQL suites abort unless the
# database name ends in `_test`:
# set -a && source .env.testing.mysql && set +a
# composer test:accounting:mysql
#
# Or run one suite directly:
# ./vendor/bin/phpunit --configuration phpunit.mysql.xml \
#   Modules/Accounting/tests/Feature/Reliability/AccountingReliabilityTest.php \
#   Modules/Accounting/tests/Feature/Compliance/TaxComplianceMySqlMigrationTest.php \
#   Modules/Accounting/tests/Feature/Compliance/TaxComplianceMySqlConcurrencyTest.php \
#   Modules/Accounting/tests/Feature/Posting/OperationalFinanceMySqlConcurrencyTest.php \
#   Modules/Accounting/tests/Feature/Posting/ProcurementInventoryMySqlConcurrencyTest.php
